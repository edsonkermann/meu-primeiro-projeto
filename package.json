{
  "name": "valdoria",
  "version": "0.1.0",
  "private": true,
  "description": "Valdoria: protótipo de MMORPG com servidor autoritativo em Node.js e cliente web em Canvas.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build.mjs --demo",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
